{
  "candle_dir": "data/stocks/daily",
  "source_cache_dir": "data/stocks_cache/global_etf_1x_sector17_daily_end20260529",
  "out_dir": "data/grid/us_etf_1x_sector17_rank_absmom_topn_spy_benchmark_v2",
  "run_name_template": "us_etf_1x_rank{rank_months}_abs{absmom_window}_top{top_n}_posmonth20m_ge11_spy_v2",
  "compute_rolling_ir": false,
  "print_run_summaries": false,
  "save_run_artifacts": true,
  "shared_feature_spec_template": [
    {
      "source": "signal_price",
      "steps": [
        {
          "kind": "simple_return",
          "params": {
            "window": 1
          }
        },
        {
          "kind": "rolling_std",
          "params": {
            "window": 10
          }
        }
      ],
      "column_name": "realized_vol_10d"
    },
    {
      "source": "realized_vol_10d",
      "steps": [
        {
          "kind": "rolling_percentile",
          "params": {
            "window": 252
          }
        }
      ],
      "column_name": "realized_vol_10d_pct252d"
    },
    {
      "source": "signal_price",
      "steps": [
        {
          "kind": "simple_return",
          "params": {
            "window": 1
          }
        }
      ],
      "column_name": "daily_return"
    },
    {
      "compare": {
        "left_feature": "daily_return",
        "operator": "gt",
        "right_value": 0.0
      },
      "column_name": "positive_day_flag"
    },
    {
      "source": "signal_price",
      "steps": [
        {
          "kind": "period_simple_return",
          "params": {
            "freq": "M",
            "periods": 1,
            "signal_timing": "next_period"
          }
        }
      ],
      "column_name": "completed_month_return"
    },
    {
      "compare": {
        "left_feature": "completed_month_return",
        "operator": "gt",
        "right_value": 0.0
      },
      "column_name": "completed_month_positive_flag"
    },
    {
      "compare": {
        "left_feature": "signal_price",
        "operator": "gt",
        "right_value": 0.0
      },
      "column_name": "always_eligible"
    }
  ],
  "feature_spec_template": [
    {
      "source": "completed_month_positive_flag",
      "steps": [
        {
          "kind": "calendar_rolling_sum",
          "params": {
            "freq": "M",
            "periods": 20,
            "skip_periods": 0,
            "signal_timing": "same_period"
          }
        }
      ],
      "column_name": "positive_month_count"
    },
    {
      "compare": {
        "left_feature": "positive_month_count",
        "operator": "ge",
        "right_value": 11
      },
      "column_name": "positive_month_qualified"
    },
    {
      "source": "positive_day_flag",
      "steps": [
        {
          "kind": "rolling_mean",
          "params": {
            "window": 252
          }
        },
        {
          "kind": "calendar_mean",
          "params": {
            "freq": "M",
            "signal_timing": "next_period"
          }
        },
        {
          "kind": "cross_percentile",
          "params": {
            "descending": true
          }
        }
      ],
      "column_name": "continuity_252d_cross_pct_monthly"
    },
    {
      "compare": {
        "left_feature": "continuity_252d_cross_pct_monthly",
        "operator": "le",
        "right_value": 0.9
      },
      "column_name": "continuity_252d_keep90"
    },
    {
      "source": "signal_price",
      "steps": [
        {
          "kind": "simple_return",
          "params": {
            "window": 1
          }
        },
        {
          "kind": "cross_rank",
          "params": {
            "descending": true
          }
        },
        {
          "kind": "calendar_mean",
          "params": {
            "freq": "M",
            "signal_timing": "same_period"
          }
        },
        {
          "kind": "calendar_rolling_sum",
          "params": {
            "freq": "M",
            "periods": "{rank_months}",
            "skip_periods": 1,
            "signal_timing": "next_period"
          }
        }
      ],
      "column_name": "daily_rank_monthavg_{rank_months}m_skip1m_sum"
    },
    {
      "source": "signal_price",
      "steps": [
        {
          "kind": "simple_return",
          "params": {
            "window": "{absmom_window}"
          }
        }
      ],
      "column_name": "absmom_{absmom_window}d"
    }
  ],
  "universe_spec_template": {
    "name": "{run_name}",
    "feature_column": "daily_rank_monthavg_{rank_months}m_skip1m_sum",
    "lag": 0,
    "signal_lag": 0,
    "mode": "top_n",
    "top_n": "{top_n}",
    "ascending": true,
    "allowed_markets": [
      "IYW-KRW",
      "IYE-KRW",
      "IYF-KRW",
      "IYR-KRW",
      "IYH-KRW",
      "IYM-KRW",
      "GLD-KRW",
      "TLT-KRW",
      "EEM-KRW",
      "EWJ-KRW",
      "IYC-KRW",
      "IYK-KRW",
      "IDU-KRW",
      "IYJ-KRW",
      "IBB-KRW",
      "IYZ-KRW",
      "IWM-KRW"
    ],
    "value_filters": [
      {
        "feature_column": "absmom_{absmom_window}d",
        "operator": "gt",
        "value": 0.0,
        "lag": 1
      },
      {
        "feature_column": "realized_vol_10d_pct252d",
        "operator": "le",
        "value": 0.975,
        "lag": 1
      },
      {
        "feature_column": "positive_month_qualified",
        "operator": "eq",
        "value": 1.0,
        "lag": 0
      },
      {
        "feature_column": "continuity_252d_keep90",
        "operator": "eq",
        "value": 1.0,
        "lag": 0
      }
    ]
  },
  "weight_spec_template": {
    "weighting": "equal",
    "gross_exposure": 1.0,
    "rebalance_frequency": "change_only",
    "universe_name": "{run_name}"
  },
  "vectorbt_spec_template": {
    "price_column": "trade_price",
    "fees": 0.0005,
    "slippage": 0.0,
    "benchmark_market": "SPY-KRW",
    "benchmark_mode": "single_market",
    "trim_start_mode": "timestamp",
    "trim_start_timestamp": "2012-05-01 00:00:00",
    "benchmark_source_cache_dir": "data/stocks_cache/global_etf_1x_2x_sector17_spy_daily_end20260529"
  },
  "grid": {
