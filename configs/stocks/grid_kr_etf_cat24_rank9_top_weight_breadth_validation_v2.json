{
  "candle_dir": "data/stocks/daily",
  "source_cache_dir": "data/stocks_cache/kr_etf_daily",
  "out_dir": "data/grid/kr_etf_cat24_rank9_top_weight_breadth_validation_v2",
  "run_name_template": "kr_etf_cat24_rank9_corr095_{weight_label}_{breadth_label}_changeonly_fee5bp_v2",
  "compute_rolling_ir": false,
  "print_run_summaries": false,
  "save_run_artifacts": false,
  "shared_feature_spec_template": [
    {
      "source": "signal_price",
      "steps": [
        { "kind": "simple_return", "params": { "window": 1 } },
        { "kind": "cross_rank", "params": { "descending": true } },
        { "kind": "calendar_mean", "params": { "freq": "M", "signal_timing": "same_period" } },
        { "kind": "calendar_rolling_sum", "params": { "freq": "M", "periods": 9, "skip_periods": 1, "signal_timing": "next_period" } }
      ],
      "column_name": "rank_score_raw_m9_skip1"
    },
    {
      "source": "rank_score_raw_m9_skip1",
      "steps": [
        {
          "kind": "corr_greedy_filter",
          "params": {
            "price_feature": "signal_price",
            "liquidity_feature": "candle_acc_trade_price",
            "threshold": 0.95,
            "corr_window": 252,
            "min_periods": 160,
            "liquidity_window": 63,
            "freq": "M",
            "signal_timing": "next_period"
          }
        }
      ],
      "column_name": "rank_score_corr095_m9_skip1"
    },
    {
      "source": "candle_acc_trade_price",
      "steps": [
        { "kind": "calendar_mean", "params": { "freq": "M", "signal_timing": "next_period" } }
      ],
      "column_name": "liquidity_prev_month_avg"
    },
    {
      "source": "signal_price",
      "steps": [
        { "kind": "period_simple_return", "params": { "freq": "M", "periods": 3, "signal_timing": "next_period" } }
      ],
      "column_name": "return_3m"
    },
    {
      "compare": { "left_feature": "return_3m", "operator": "gt", "right_value": 0.0 },
      "column_name": "return_3m_pos"
    },
    {
      "breadth": {
        "driver_feature": "liquidity_prev_month_avg",
        "signal_feature": "return_3m_pos",
        "mode": "top_n",
        "top_n": 200,
        "ascending": false
      },
      "column_name": "breadth_top200_pos3m_ratio"
    },
    {
      "compare": { "left_feature": "breadth_top200_pos3m_ratio", "operator": "gt", "right_value": 0.4 },
      "column_name": "risk_on_breadth_top200_pos3m_gt40"
    },
    {
      "compare": { "left_feature": "breadth_top200_pos3m_ratio", "operator": "gt", "right_value": 0.45 },
      "column_name": "risk_on_breadth_top200_pos3m_gt45"
    },
    {
      "compare": { "left_feature": "breadth_top200_pos3m_ratio", "operator": "gt", "right_value": 0.5 },
      "column_name": "risk_on_breadth_top200_pos3m_gt50"
    }
  ],
  "universe_spec_template": {
    "name": "{run_name}",
    "feature_column": "rank_score_corr095_m9_skip1",
    "lag": 0,
    "signal_lag": 0,
    "mode": "top_n",
    "top_n": "{top_n}",
    "ascending": true,
    "allowed_markets_file": "data/kr_etfs/universe/kr_etf_cat24_structure_excluded_markets.json"
  },
  "weight_spec_template": {
    "weighting": "rank_fixed",
    "rank_weight_feature": "rank_score_corr095_m9_skip1",
    "rank_weight_ascending": true,
    "rank_weights": [
      "{w1}",
      "{w2}",
      "{w3}"
    ],
    "gross_exposure": 1.0,
    "gross_exposure_feature": "{risk_feature}",
    "gross_exposure_lag": 0,
    "gross_exposure_clip_min": 0.0,
    "gross_exposure_clip_max": 1.0,
    "rebalance_frequency": "change_only",
    "universe_name": "{run_name}"
  },
  "vectorbt_spec_template": {
    "price_column": "trade_price",
    "fees": 0.0005,
    "slippage": 0.0,
    "benchmark_market": "PORTFOLIO_GROUP_REBALANCE",
    "benchmark_mode": "portfolio_group_rebalance",
    "benchmark_rebalance_frequency": "monthly",
    "benchmark_listed_normalize": true,
    "trim_start_mode": "timestamp",
    "trim_start_timestamp": "2008-03-03 00:00:00"
  },
  "grid": {
    "weight_label": [
      "top1_w100",
      "top2_w8020",
      "top2_w7030",
      "top3_w603010",
      "top3_w503020"
    ],
    "top_n": [1, 2, 3],
    "w1": [1.0, 0.8, 0.7, 0.6, 0.5],
    "w2": [0.0, 0.2, 0.3],
    "w3": [0.0, 0.1, 0.2],
    "breadth_label": [
      "breadth200_gt40",
      "breadth200_gt45",
      "breadth200_gt50"
    ],
    "risk_feature": [
      "risk_on_breadth_top200_pos3m_gt40",
      "risk_on_breadth_top200_pos3m_gt45",
      "risk_on_breadth_top200_pos3m_gt50"
    ]
  },
  "constraints": [
    "((weight_label == 'top1_w100' and top_n == 1 and w1 == 1.0 and w2 == 0.0 and w3 == 0.0) or (weight_label == 'top2_w8020' and top_n == 2 and w1 == 0.8 and w2 == 0.2 and w3 == 0.0) or (weight_label == 'top2_w7030' and top_n == 2 and w1 == 0.7 and w2 == 0.3 and w3 == 0.0) or (weight_label == 'top3_w603010' and top_n == 3 and w1 == 0.6 and w2 == 0.3 and w3 == 0.1) or (weight_label == 'top3_w503020' and top_n == 3 and w1 == 0.5 and w2 == 0.3 and w3 == 0.2)) and ((breadth_label == 'breadth200_gt40' and risk_feature == 'risk_on_breadth_top200_pos3m_gt40') or (breadth_label == 'breadth200_gt45' and risk_feature == 'risk_on_breadth_top200_pos3m_gt45') or (breadth_label == 'breadth200_gt50' and risk_feature == 'risk_on_breadth_top200_pos3m_gt50'))"
  ]
}
