{
  "candle_dir": "data/stocks/daily",
  "source_cache_dir": "data/stocks_cache/kr_stock_daily",
  "out_dir": "data/grid/kr_stock_kospi_common_avgmcap100_indpct_g3_rank9_18_skip0123_top5_indcap2_kospi200_benchmark_v2",
  "run_name_template": "kr_stock_kospi_common_avgmcap100_indpct_g{min_group}_rank{rank_months}_skip{skip_months}_top5_indcap{ind_cap}_monthly_kospi200_benchmark_v2",
  "compute_rolling_ir": false,
  "print_run_summaries": false,
  "save_run_artifacts": false,
  "shared_feature_spec_template": [
    {
      "source": "market_cap",
      "steps": [
        {
          "kind": "calendar_mean",
          "params": {
            "freq": "M",
            "signal_timing": "next_period"
          }
        }
      ],
      "column_name": "market_cap_prev_month_avg"
    },
    {
      "source": "custom:common_share_flag",
      "steps": [],
      "column_name": "common_share_raw"
    },
    {
      "source": "market_code",
      "steps": [],
      "column_name": "market_code_raw"
    },
    {
      "source": "price_available",
      "steps": [],
      "column_name": "price_available_raw"
    },
    {
      "source": "marcap_available",
      "steps": [],
      "column_name": "marcap_available_raw"
    },
    {
      "compare": {
        "left_feature": "market_code_raw",
        "operator": "eq",
        "right_value": 1.0
      },
      "column_name": "is_kospi_raw"
    },
    {
      "source": "is_kospi_raw",
      "steps": [
        {
          "kind": "shift",
          "params": {
            "periods": 1
          }
        }
      ],
      "column_name": "is_kospi_lag1"
    },
    {
      "compare": {
        "left_feature": "price_available_raw",
        "operator": "ge",
        "right_value": 1.0
      },
      "column_name": "price_available_flag_raw"
    },
    {
      "source": "price_available_flag_raw",
      "steps": [
        {
          "kind": "shift",
          "params": {
            "periods": 1
          }
        }
      ],
      "column_name": "price_available_flag_lag1"
    },
    {
      "compare": {
        "left_feature": "marcap_available_raw",
        "operator": "ge",
        "right_value": 1.0
      },
      "column_name": "marcap_available_flag_raw"
    },
    {
      "source": "marcap_available_flag_raw",
      "steps": [
        {
          "kind": "shift",
          "params": {
            "periods": 1
          }
        }
      ],
      "column_name": "marcap_available_flag_lag1"
    },
    {
      "logical": {
        "operator": "and",
        "features": [
          "is_kospi_lag1",
          "price_available_flag_lag1",
          "marcap_available_flag_lag1"
        ]
      },
      "column_name": "kr_stock_base_mask_lag1"
    },
    {
      "source": "market_cap_prev_month_avg",
      "steps": [
        {
          "kind": "mask_by_feature",
          "params": {
            "feature": "kr_stock_base_mask_lag1"
          }
        }
      ],
      "column_name": "market_cap_prev_month_avg_in_base"
    },
    {
      "compare": {
        "left_feature": "common_share_raw",
        "operator": "eq",
        "right_value": 1.0
      },
      "column_name": "is_common_raw"
    },
    {
      "logical": {
        "operator": "and",
        "features": [
          "is_kospi_raw",
          "is_common_raw",
          "price_available_flag_raw"
        ]
      },
      "column_name": "kospi_common_rank_mask_raw"
    },
    {
      "source": "trade_price",
      "steps": [
        {
          "kind": "simple_return",
          "params": {
            "window": 1
          }
        },
        {
          "kind": "mask_by_feature",
          "params": {
            "feature": "kospi_common_rank_mask_raw"
          }
        },
        {
          "kind": "cross_percentile",
          "params": {
            "descending": true
          }
        },
        {
          "kind": "calendar_mean",
          "params": {
            "freq": "M",
            "signal_timing": "same_period"
          }
        }
      ],
      "column_name": "daily_kospipct_monthavg"
    },
    {
      "source": "custom:industry_id",
      "steps": [
        {
          "kind": "calendar_hold",
          "params": {
            "freq": "M",
            "hold_periods": 1,
            "signal_timing": "next_period",
            "anchor": "calendar",
            "broadcast_sparse": true
          }
        }
      ],
      "column_name": "industry_id_prev_month"
    },
    {
      "source": "common_share_raw",
      "steps": [
        {
          "kind": "shift",
          "params": {
            "periods": 1
          }
        }
      ],
      "column_name": "common_share_lag1"
    },
    {
      "compare": {
        "left_feature": "common_share_lag1",
        "operator": "eq",
        "right_value": 1.0
      },
      "column_name": "is_common_lag1"
    },
    {
      "logical": {
        "operator": "and",
        "features": [
          "kr_stock_base_mask_lag1",
          "is_common_lag1"
        ]
      },
      "column_name": "kospi_common_base_mask_lag1"
    },
    {
      "source": "market_cap_prev_month_avg",
      "steps": [
        {
          "kind": "mask_by_feature",
          "params": {
            "feature": "kospi_common_base_mask_lag1"
          }
        },
        {
          "kind": "cross_rank",
          "params": {
            "descending": true
          }
        }
      ],
      "column_name": "mcap_rank_in_common_base"
    },
    {
      "compare": {
        "left_feature": "mcap_rank_in_common_base",
        "operator": "le",
        "right_value": 100.0
      },
      "column_name": "is_top100_mcap"
    }
  ],
  "feature_spec_template": [
    {
      "source": "trade_price",
      "steps": [
        {
          "kind": "simple_return",
          "params": {
            "window": 1
          }
        },
        {
          "kind": "mask_by_feature",
          "params": {
            "feature": "kospi_common_rank_mask_raw"
          }
        },
        {
          "kind": "group_percentile",
          "params": {
            "group_feature": "industry_id_prev_month",
            "descending": true,
            "min_group_size": "{min_group}"
          }
        },
        {
          "kind": "calendar_mean",
          "params": {
            "freq": "M",
            "signal_timing": "same_period"
          }
        },
        {
          "kind": "calendar_rolling_sum",
          "params": {
            "freq": "M",
            "periods": "{rank_months}",
            "skip_periods": "{skip_months}",
            "signal_timing": "next_period"
          }
        }
      ],
      "column_name": "daily_indpct_g{min_group}_monthavg_{rank_months}m_skip{skip_months}m_sum"
    },
    {
      "source": "daily_indpct_g{min_group}_monthavg_{rank_months}m_skip{skip_months}m_sum",
      "steps": [
        {
          "kind": "mask_by_feature",
          "params": {
            "feature": "is_top100_mcap"
          }
        },
        {
          "kind": "group_rank",
          "params": {
            "group_feature": "industry_id_prev_month",
            "descending": false,
            "min_group_size": 1
          }
        }
      ],
      "column_name": "indrank_in_top100_g{min_group}_{rank_months}m_skip{skip_months}m"
    }
  ],
  "universe_spec_template": {
    "name": "{run_name}",
    "feature_column": "daily_indpct_g{min_group}_monthavg_{rank_months}m_skip{skip_months}m_sum",
    "lag": 0,
    "signal_lag": 0,
    "mode": "top_n",
    "top_n": 5,
    "ascending": true,
    "start_min_cross_section_size": 100,
    "value_filters": [
      {
        "feature_column": "market_code_raw",
        "operator": "eq",
        "value": 1.0,
        "lag": 1
      },
      {
        "feature_column": "common_share_raw",
        "operator": "eq",
        "value": 1.0,
        "lag": 1
      },
      {
        "feature_column": "price_available_raw",
        "operator": "ge",
        "value": 1.0,
        "lag": 1
      },
      {
        "feature_column": "marcap_available_raw",
        "operator": "ge",
        "value": 1.0,
        "lag": 1
      },
      {
        "feature_column": "indrank_in_top100_g{min_group}_{rank_months}m_skip{skip_months}m",
        "operator": "le",
        "value": "{ind_cap}",
        "lag": 0
      }
    ],
    "filter_stages": [
      {
        "mode": "sequential",
        "filters": [
          {
            "feature_column": "market_cap_prev_month_avg",
            "mode": "top_n",
            "top_n": 100,
            "ascending": false,
            "scope": "filtered",
            "lag": 0
          }
        ]
      }
    ]
  },
  "weight_spec_template": {
    "weighting": "equal",
    "gross_exposure": 1.0,
    "rebalance_frequency": "monthly",
    "universe_name": "{run_name}"
  },
  "vectorbt_spec_template": {
    "price_column": "trade_price",
    "benchmark_price_column": "index_price",
    "fees": 0.0015,
    "slippage": 0.001,
    "prune_inactive_price_columns": true,
    "benchmark_market": "KOSPI200",
    "benchmark_mode": "single_market",
    "trim_start_mode": "timestamp",
    "trim_start_timestamp": "2016-01-01 00:00:00",
    "execution_availability": {
      "volume_column": "candle_acc_trade_volume"
    }
  },
  "grid": {
    "min_group": [
      3
    ],
    "rank_months": [
      9,
      12,
      15,
      18
    ],
    "skip_months": [
      0,
      1,
      2,
      3
    ],
    "ind_cap": [
      2
    ]
  },
  "constraints": [
    "rank_months > skip_months"
  ]
}